#!/usr/bin/env python3
"""ship-pr: draft a PR body with Claude (mattpocock-skills:pr), collapse it, push, open the PR, print the link.

Run from inside a repo, on the branch to ship:
    ship-pr                 # base main
    ship-pr --base develop
    ship-pr --dry-run       # print title + body, push nothing

Env overrides: SHIP_PR_MODEL (default claude-opus-5-5), SHIP_PR_EFFORT (default medium).
Writes nothing to disk.
"""
import argparse
import json
import os
import subprocess
import sys

MODEL = os.environ.get("SHIP_PR_MODEL", "claude-opus-5-5")
EFFORT = os.environ.get("SHIP_PR_EFFORT", "medium")
CLAUDE = os.environ.get("SHIP_PR_CLAUDE_BIN", "claude")
ATTRIBUTION = "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
LABELS = {"claude-opus-5-5": "Claude Opus 5.5", "claude-sonnet-5-5": "Claude Sonnet 5.5",
          "claude-haiku-5-5": "Claude Haiku 5.5", "claude-fable-5-1": "Claude Fable 5.1"}
SCHEMA = {
	"type": "object",
	"properties": {"title": {"type": "string"}, "body": {"type": "string"}},
	"required": ["title", "body"],
	"additionalProperties": False,
}
PROMPT = """Write the pull request for the commits on branch {head} that are not on origin/{base}.

Use the mattpocock-skills:pr skill: load it and follow its template for the body.
Look at the change with `git log origin/{base}..HEAD` and `git diff origin/{base}...HEAD`.

Return a short imperative PR title and the body markdown. The body is only the skill's template
sections; this script adds any wrapper and attribution, and opens the PR itself."""


def sh(*cmd: str, check: bool = True, input: str | None = None) -> str:
	r = subprocess.run(cmd, text=True, capture_output=True, input=input)
	if check and r.returncode != 0:
		sys.exit(f"$ {' '.join(cmd)}\n{r.stderr.strip() or r.stdout.strip()}")
	return r.stdout.strip()


def draft(head: str, base: str) -> tuple[str, str]:
	cmd = [CLAUDE, "-p", PROMPT.format(head=head, base=base),
	       "--model", MODEL, "--effort", EFFORT,
	       "--output-format", "json", "--json-schema", json.dumps(SCHEMA),
	       "--permission-mode", "dontAsk", "--no-session-persistence",
	       "--allowedTools", "Skill", "Read", "Grep", "Glob",
	       "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)", "Bash(git status:*)"]
	print(f"drafting with {MODEL} ({EFFORT})...", file=sys.stderr)
	out = json.loads(sh(*cmd))
	if out.get("is_error"):
		sys.exit(f"claude failed: {out.get('result')}")
	data = out.get("structured_output") or json.loads(out["result"])
	return data["title"].strip(), data["body"]


def collapse(body: str) -> str:
	label = LABELS.get(MODEL, MODEL) + (f" {EFFORT.capitalize()}" if EFFORT else "")
	inner = "\n".join(l for l in body.strip("\n").splitlines() if l.strip() != ATTRIBUTION).strip("\n")
	return f"\n\n<details>\n<summary>{label}</summary>\n\n{inner}\n\n</details>\n\n{ATTRIBUTION}\n"


def main() -> None:
	ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
	ap.add_argument("--base", default="main")
	ap.add_argument("--dry-run", action="store_true")
	a = ap.parse_args()

	head = sh("git", "branch", "--show-current")
	if not head or head == a.base:
		sys.exit(f"check out the branch to ship first (on: {head or 'detached HEAD'})")
	sh("git", "fetch", "-q", "origin", a.base)
	if sh("git", "rev-list", "--count", f"origin/{a.base}..HEAD") == "0":
		sys.exit(f"{head} has no commits beyond origin/{a.base}")
	existing = sh("gh", "pr", "view", head, "--json", "url,state", "-q", 'select(.state=="OPEN").url', check=False)
	if existing and not a.dry_run:
		sys.exit(f"PR already open: {existing}")

	title, body = draft(head, a.base)
	body = collapse(body)
	if a.dry_run:
		print(f"title: {title}\n{body}")
		return

	sh("git", "push", "-u", "origin", f"HEAD:refs/heads/{head}")
	url = sh("gh", "pr", "create", "--base", a.base, "--head", head, "--title", title, "--body-file", "-", input=body)
	print(url.splitlines()[-1])
	print("opener is blank: add your summary on GitHub.", file=sys.stderr)


if __name__ == "__main__":
	main()
